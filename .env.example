# Copy to .env and change every value marked CHANGE-ME. Never commit .env.

POSTGRES_USER=namaa
POSTGRES_PASSWORD=CHANGE-ME-database-password
POSTGRES_DB=namaa

# First administrator, created on first start if no administrator exists.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=CHANGE-ME-at-least-10-characters

# Address users open in the browser; used in password reset links.
PUBLIC_BASE_URL=http://127.0.0.1:3000

# Set to true when the site is served over HTTPS.
COOKIE_SECURE=false

# Analysis settings (defaults shown).
MIN_MONITORING_AREA_M2=5000
MIN_VALID_SHARE=0.7

# Install test tools in the backend image (set false for production builds).
BACKEND_INSTALL_DEV=true

# Host ports (change if 3000/8000 are already used on this machine).
FRONTEND_PORT=3000
BACKEND_PORT=8000

# Optional server-side AI assistance. Paste your key here; never use NEXT_PUBLIC_ for secrets.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# For gpt-6-luna structured briefs, set none to keep the output budget for the answer.
# Leave blank for models that do not support reasoning_effort.
OPENAI_REASONING_EFFORT=
AI_DAILY_LIMIT_PER_USER=30

# Worker refreshes recent satellite acquisitions and weather for registered active sites.
WEATHER_AUTO_REFRESH=true
SATELLITE_AUTO_REFRESH=true
SATELLITE_REFRESH_HOURS=24
SATELLITE_REFRESH_DAYS=30
